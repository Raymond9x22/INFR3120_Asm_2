<%- include('partials/header') %>

<!-- Contact page -->
<h1>Contact me</h1>
<p>Send me your questions, or anything. All fields are required.</p>

<form action="mailto:manhin.wong@ontariotechu.net" method="post" enctype="text/plain">
  <div class="mb-3">
    <label for="name" class="form-label">Your name</label>
    <input type="text" id="name" name="name" class="form-control" placeholder="First and last name" required>
  </div>

  <div class="mb-3">
    <label for="email" class="form-label">Your email</label>
    <input type="email" id="email" name="email" class="form-control" placeholder="name@example.com" required>
  </div>

  <div class="mb-3">
    <label for="phone" class="form-label">Cell number</label>
    <input type="tel" id="phone" name="phone" class="form-control" placeholder="905-555-0123" required>
  </div>

  <div class="mb-3">
    <label for="comments" class="form-label">Comments</label>
    <textarea id="comments" name="comments" class="form-control" rows="5" placeholder="Question, comment or query" required></textarea>
  </div>

  <button type="submit" class="btn btn-primary"><i class="fa-solid fa-paper-plane"></i> Send message</button>
  <button type="reset" class="btn btn-secondary">Clear form</button>
</form>

<%- include('partials/footer') %>